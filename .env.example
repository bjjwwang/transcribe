# Required: web UI password (any non-empty string).
APP_PASSWORD=changeme

# Optional: a stable secret used to sign session cookies. If unset, a new one
# is generated on every restart — which invalidates everyone's session.
# SESSION_SECRET=long-random-string-here

# Required for pyannote speaker diarization (it's a gated Hugging Face model).
# Get one at https://huggingface.co/settings/tokens and accept the model's terms
# at https://huggingface.co/pyannote/speaker-diarization-community-1
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to 1 once you're serving over HTTPS (e.g. behind a Cloudflare tunnel),
# so the session cookie gets the Secure attribute.
COOKIE_SECURE=1

# Seconds of GPU idle time after which the worker calls torch.cuda.empty_cache()
# to release VRAM back to the driver. The process stays up.
# IDLE_GPU_RELEASE_SECONDS=1800
